{
  "name": "choria-choria",
  "version": "0.32.1",
  "author": "R.I.Pienaar <rip@devco.net>",
  "license": "Apache-2.0",
  "summary": "Install and manage the Choria Orchestrator",
  "source": "https://github.com/choria-io/puppet-choria",
  "project_page": "https://github.com/choria-io/puppet-choria",
  "issues_url": "https://github.com/choria-io/puppet-choria/issues",
  "dependencies": [
    { "name": "puppetlabs/stdlib", "version_requirement": ">= 9.0.0 < 11.0.0" },
    { "name": "puppetlabs/apt", "version_requirement": ">= 9.2.0 < 12.0.0" },
    { "name": "puppetlabs/concat", "version_requirement": ">= 9.0.0 < 11.0.0" },
    { "name": "choria/mcollective_choria", "version_requirement": ">= 0.23.0 < 2.0.0" },
    { "name": "choria/mcollective", "version_requirement": ">= 0.15.0 < 2.0.0" },
    { "name": "choria/mcollective_agent_puppet", "version_requirement": ">= 2.5.0" },
    { "name": "choria/mcollective_agent_package", "version_requirement": ">= 5.5.1" },
    { "name": "choria/mcollective_agent_service", "version_requirement": ">= 4.1.0" },
    { "name": "choria/mcollective_agent_filemgr", "version_requirement": ">= 2.1.0" },
    { "name": "choria/mcollective_util_actionpolicy", "version_requirement": ">= 3.3.0" }
  ],
  "operatingsystem_support": [
    { "operatingsystem": "CentOS" },
    { "operatingsystem": "Debian" },
    { "operatingsystem": "Fedora" },
    { "operatingsystem": "FreeBSD" },
    { "operatingsystem": "OracleLinux" },
    { "operatingsystem": "RedHat" },
    { "operatingsystem": "RockyLinux" },
    { "operatingsystem": "AlmaLinux" },
    { "operatingsystem": "Ubuntu" },
    { "operatingsystem": "Windows" }
  ],
  "requirements": [
    {
      "name": "puppet",
      "version_requirement": ">= 8.0.0 < 10.0.0"
    }
  ]
}
